# Supply values through your shell or Render; never commit real credentials.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE
RETONE_PHONE_SECRET=replace-with-a-stable-random-secret-of-at-least-32-characters
RETONE_ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-16-characters
RETONE_ADMIN_TOTP_SECRET=REPLACE_WITH_A_RANDOM_BASE32_KEY
# Optional AI integration
OPENAI_API_KEY=
RETONE_OPENAI_MODEL=gpt-4o-mini
# Optional external image storage; otherwise private PostgreSQL storage is used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Local HTTP only; leave absent in production.
# RETONE_INSECURE_COOKIES=true
PORT=4000
